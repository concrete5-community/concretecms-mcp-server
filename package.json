{
  "name": "concretecms-mcp",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "build": "tsc",
    "pack": "node scripts/pack.mjs concretecms-mcp-server.mcpb",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --enable-source-maps --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=@reporters/github --test-reporter-destination=stdout dist/tools/*.test.js",
    "verify:oauth": "npm run build && node scripts/verify-oauth-session.mjs",
    "verify:security": "npm run build && node scripts/verify-security.mjs",
    "cleanup:tokens": "npm run build && node scripts/cleanup-tokens.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "@ivotoby/openapi-mcp-server": "^1.17.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "openid-client": "^6.8.2"
  },
  "devDependencies": {
    "@reporters/github": "^2.1.4",
    "@types/node": "^24.13.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
