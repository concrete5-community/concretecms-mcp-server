# ConcreteCMS MCP Server configuration.
# The values below are the defaults
# The four required variables have example placeholders that you must replace.

# --- Required ---

# The URL of your ConcreteCMS installation
CONCRETE_CANONICAL_URL=https://cms.example.com

# The Client ID of your ConcreteCMS API integration
CONCRETE_API_CLIENT_ID=YOUR_API_CLIENT_ID

# The Client Secret of your ConcreteCMS API integration
CONCRETE_API_CLIENT_SECRET=YOUR_API_CLIENT_SECRET

# Space-separated list of API integration scopes
CONCRETE_API_SCOPE=account:read system:info:read

# --- Optional ---

# Transport type:
# - stdio for local mode
# - http for remote mode
# Default: stdio
TRANSPORT_TYPE=

# Secret key used to encrypt stored tokens - required for http mode
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Default: empty string
TOKEN_ENCRYPTION_KEY=

# User key used to store user tokens (stdio mode)
# Default: local
CONCRETE_USER_ID=

# The public URL of this MCP server (e.g. https://mcp.example.com) - required for http mode
# Default: empty string
PUBLIC_BASE_URL=

# A Bearer token for MCP clients - required for http mode
# Alternatively you can use MCP_API_KEYS for per-user authentication
# Default: empty string
MCP_API_KEY=

# A JSON map of API keys to CMS user IDs (null = dynamic) - required for http mode
# Alternatively you can use MCP_API_KEY single-user authentication
# Example: {"personal-desktop-key":42,"dashboard-backend-key":null}
# Default: empty map
MCP_API_KEYS=

# Path prefix for all HTTP routes, e.g. /ccm-mcp
# Default: empty string
PATH_PREFIX=

# Bind address for the HTTP server
# Default: 0.0.0.0
HTTP_HOST=

# Listen port for the HTTP server
# Default: 3000
HTTP_PORT=

# Base directory for storing tokens
# Per-site subdirectories are created automatically
# Default: ~/.concretecms-mcp/tokens
TOKEN_DIR=

# Streamable HTTP MCP endpoint
# Default: {PATH_PREFIX}/mcp
MCP_ENDPOINT_PATH=

# OAuth initiation path
# Default: {PATH_PREFIX}/oauth/start
OAUTH_START_PATH=

# OAuth redirect path
# Default: {PATH_PREFIX}/oauth/callback
OAUTH_CALLBACK_PATH=

# OAuth status path
# Default: {PATH_PREFIX}/oauth/status
OAUTH_STATUS_PATH=

# Per-user token revocation path
# Default: {PATH_PREFIX}/oauth/revoke
OAUTH_REVOKE_PATH=

# Health check path
# Default: {PATH_PREFIX}/health
HEALTH_PATH=

# Allow connecting to a Concrete server over plain HTTP instead of HTTPS
# For local/development instances only - never enable against a production server
# Default: false
CONCRETE_ALLOW_INSECURE_HTTP=

# Enable debug logging for OAuth flows
# Default: false
OAUTH_DEBUG=

# Log Concrete REST requests and responses (method, URL, bodies, status) to the server log for troubleshooting
# Sensitive fields are redacted and bodies truncated by default
# Default: false
CONCRETE_API_DEBUG=

# Max number of characters logged for each request/response body in any debug output.
# Set to 0 to log full bodies without truncation
# Default: 2000
DEBUG_MAX_BODY=
